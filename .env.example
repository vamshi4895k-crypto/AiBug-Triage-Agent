# Server Configuration
PORT=3001
NODE_ENV=development

# AI Provider Configuration
# Set AI_API_KEY (e.g. your Google Gemini API Key, OpenAI API Key, or Groq API Key)
# If no key is set, the application will seamlessly use the built-in offline Heuristic Triage Engine
AI_API_KEY=
AI_PROVIDER=gemini
AI_MODEL=gemini-2.0-flash

# Optional OpenAI / Custom Endpoint settings
# AI_PROVIDER=openai
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1

# Client Configuration
VITE_API_BASE_URL=http://localhost:3001/api
